# Copy to .env and never commit the real file.
DB_URL=jdbc:postgresql://localhost:5432/parking_lot
DB_USERNAME=parking
DB_PASSWORD=parking
# Host port for the Docker Postgres. Change it if a local Postgres already uses 5432,
# and update the port in DB_URL to match.
DB_PORT=5432
# Needed once you build PLS-022. Use at least 32 random bytes, base64 encoded.
JWT_SECRET=change-me

# Logging. Levels: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO
# DEBUG prints every SQL statement.
LOG_LEVEL_SQL=INFO
LOG_FILE=logs/parking-lot.log
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=1GB
DB_SLOW_QUERY_MS=500
