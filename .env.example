# Copy to .env and never commit the real file.
DB_URL=jdbc:postgresql://localhost:5432/parking_lot
DB_USERNAME=parking
DB_PASSWORD=parking
# Host port for the Docker Postgres. Change it if a local Postgres already uses 5432,
# and update the port in DB_URL to match.
DB_PORT=5432
# Needed once you build PLS-022. Use at least 32 random bytes, base64 encoded.
JWT_SECRET=change-me
